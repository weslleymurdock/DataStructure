@page "/algorythms"

@using DataStructure.github.io.Services
@inject IDialogService DialogService

<PageTitle>Algoritmos</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="py-6">
    <MudStack Spacing="4">
        <MudText Typo="Typo.h3">Algoritmos</MudText>
        <MudText>Clique em um algoritmo para ver a lógica passo a passo e o fluxo visual.</MudText>

        @foreach (var group in Groups)
        {
            <MudPaper Elevation="2" Class="pa-4">
                <MudText Typo="Typo.h4">@group.Title</MudText>
                <MudText Typo="Typo.body2">@group.Description</MudText>
                <MudTable Items="@group.Items" Hover="true" Striped="true" Class="mt-2">
                    <HeaderContent>
                        <MudTh>Algoritmo</MudTh>
                        <MudTh>Complexidade</MudTh>
                        <MudTh>Pré-condições</MudTh>
                        <MudTh>Aplicação</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTr @onclick="@(() => Open(context))" Style="cursor:pointer">
                            <MudTd DataLabel="Algoritmo">@context.Name</MudTd>
                            <MudTd DataLabel="Complexidade">@context.Complexity</MudTd>
                            <MudTd DataLabel="Pré-condições">@context.Preconditions</MudTd>
                            <MudTd DataLabel="Aplicação">@context.StructureScope</MudTd>
                        </MudTr>
                    </RowTemplate>
                </MudTable>
            </MudPaper>
        }

        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
            Em estruturas não lineares, o laboratório informa quando a execução usa uma travessia
            ou uma representação linearizada. Isso mantém a explicação do algoritmo separada da
            semântica própria da estrutura.
        </MudAlert>

        <MudButton Href="/run" Variant="Variant.Filled" Color="Color.Primary">
            Abrir laboratório
        </MudButton>
    </MudStack>
</MudContainer>

@code {
    private IReadOnlyList<AlgorithmGroup> Groups =>
    [
        new("Ordenação", "Reorganizam valores em uma sequência definida.", AlgorithmCatalog.Sorts),
        new("Busca", "Localizam um alvo percorrendo ou reduzindo um espaço de pesquisa.", AlgorithmCatalog.Searches)
    ];

    private async Task Open(AlgorithmGuide algorithm)
    {
        var parameters = new DialogParameters<AlgorithmDialog>
        {
            { x => x.Guide, algorithm }
        };

        var options = new DialogOptions
        {
            CloseButton = true,
            FullWidth = true,
            MaxWidth = MaxWidth.Large,
            BackdropClick = true
        };

        await DialogService.ShowAsync<AlgorithmDialog>(algorithm.Name, parameters, options);
    }

    private sealed record AlgorithmGroup(
        string Title,
        string Description,
        IReadOnlyList<AlgorithmGuide> Items);
}
