@using DataStructure.github.io.Services

<MudDialog Class="algorithm-dialog">
    <DialogContent>
        <MudStack Spacing="3">
            <MudText Typo="Typo.h4">@Guide.Name</MudText>
            <MudText Typo="Typo.body1">@Guide.Summary</MudText>

            <MudGrid>
                <MudItem xs="12" md="4">
                    <MudPaper Class="pa-3" Elevation="1">
                        <MudText Typo="Typo.subtitle2">Complexidade</MudText>
                        <MudText>@Guide.Complexity</MudText>
                    </MudPaper>
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudPaper Class="pa-3" Elevation="1">
                        <MudText Typo="Typo.subtitle2">Pré-condições</MudText>
                        <MudText>@Guide.Preconditions</MudText>
                    </MudPaper>
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudPaper Class="pa-3" Elevation="1">
                        <MudText Typo="Typo.subtitle2">Estruturas</MudText>
                        <MudText>@Guide.StructureScope</MudText>
                    </MudPaper>
                </MudItem>
            </MudGrid>

            <MudText Typo="Typo.h5">Passo a passo</MudText>

            <MudList T="string" Dense="true">
                @for (var index = 0; index < Guide.Steps.Count; index++)
                {
                    <MudListItem>
                        <MudStack Row="true" AlignItems="AlignItems.Start" Spacing="2">
                            <MudChip T="string" Color="Color.Primary" Size="Size.Small">@(index + 1)</MudChip>
                            <MudText>@Guide.Steps[index]</MudText>
                        </MudStack>
                    </MudListItem>
                }
            </MudList>

            <MudText Typo="Typo.h5">Fluxo lógico</MudText>

            <div class="mermaid-container">
                <mermaid-embed src="@MermaidUrl" height="720"></mermaid-embed>
            </div>
        </MudStack>
    </DialogContent>

    <DialogActions>
        <MudButton OnClick="Close" Variant="Variant.Filled" Color="Color.Primary">
            Fechar
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance Dialog { get; set; } = default!;

    [Parameter]
    public AlgorithmGuide Guide { get; set; } = default!;

    private string MermaidUrl =>
        "https://mermaid.live/embed?theme=default&look=classic&mode=light&code=" +
        Uri.EscapeDataString(Guide.Mermaid);

    private void Close()
        => Dialog.Close();
}
