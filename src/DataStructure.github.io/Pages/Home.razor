@page "/"

<PageTitle>Estruturas de dados</PageTitle>

<MudText Typo="Typo.h3" GutterBottom="true">Olá, dev</MudText>
<MudText Class="mb-8">Bem vindo ao seu guia de estruturas de dados e algoritmos em .NET 10!</MudText>

<MudGrid>
    @foreach (var ds in  DataStructures)
    {
        if (DataStructures.Count % 2 != 0 && DataStructures.Last().Equals(ds))
        {
            <MudItem xs="12" sm="12">
                <MudCard>
                    <MudCardHeader>
                        <MudText Typo="Typo.h3" >@ds.Name</MudText>
                    </MudCardHeader>
                    <MudCardActions> 
                        <MudChipSet T="MudChip<string>">
                        @foreach (var algorythm in ds.Algorythms)
                        {
                            <MudChip T="string" Icon="@Icons.Material.Filled.PlaylistPlay" IconColor="@Color.Success" Value="@algorythm.Name"/>
                        } 
                        </MudChipSet>
                    </MudCardActions>
                </MudCard>
            </MudItem>    
        }
        else
        {
            <MudItem xs="12" sm="6">
                <MudCard>
                    <MudCardHeader>
                        <MudText Typo="Typo.h3">@ds.Name</MudText>
                    </MudCardHeader>
                    <MudCardActions>
                        <MudChipSet T="MudChip<string>">
                            @foreach (var algorythm in ds.Algorythms)
                            {
                                <MudChip T="string" Icon="@Icons.Material.Filled.PlaylistPlay" IconColor="@Color.Success"
                                         Value="@algorythm.Name" />
                            }
                        </MudChipSet>
                    </MudCardActions>
                </MudCard>
            </MudItem>
        }
    }
</MudGrid>
<MudTable Items="@DataStructures" Hover="true" Breakpoint="Breakpoint.Sm">
    <ColGroup>
        <col />
        <col style="width:100px;" />
        <col style="width:300px;" />
    </ColGroup>
    <HeaderContent>
        <MudTh>Name</MudTh>
        <MudTh>Page</MudTh>
        <MudTh></MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="Name">@context.Name</MudTd>
        <MudTd DataLabel="Page">@context.Page</MudTd>
        <MudTd DataLabel="Algorythms">
                     
        </MudTd>
    </RowTemplate>
     
</MudTable>

@code
{
    public ICollection<DataStructure> DataStructures = [
        new("Array", "/structures/array", Algorythms),
        new("Collection", "/structures/collection", Algorythms),
        new("Deck", "/structures/deck", Algorythms),
        new("List", "/structures/list", Algorythms),
        new("LinkedList", "/structures/linkedlist", Algorythms),
        new("NodeList", "/structures/nodelist", Algorythms),
        new("PriorityQueue", "/structures/priorityqueue", Algorythms),
        new("Queue", "/structures/queue", Algorythms),
        new("Stack", "/structures/stack", Algorythms),];
    public static readonly ICollection<Algorythm> Algorythms = [
        new("BubbleSort"), 
        new("BinarySearch"),
        new("HeapSort"),
        new("InsertionSort"),
        new("InterpolationSearch"),
        new("JumpSearch"),
        new("LinearSearch"),
        new("MergeSort"),
        new("QuickSort"),
        new("SelectionSort")
    ];

    public sealed class Algorythm
    {
        public Algorythm(string name) => (Name) = (name);
        public string Name { get; set; } 
    }
    public sealed class DataStructure
    {
        public DataStructure(string name, string page, ICollection<Algorythm> algorythms) => (Name, Page, Algorythms) = (name, page, algorythms);
        public string Name { get; set;}
        public string Page {get;set;} 
        public ICollection<Algorythm> Algorythms { get; set; }
        public bool ShowDetails { get; set; } = false;
    }
}