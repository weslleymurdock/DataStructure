@page "/"

@using DataStructure.github.io.Services

<PageTitle>Guia de estruturas de dados e algoritmos</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="py-6">
    <MudStack Spacing="5">
        <MudPaper Elevation="0" Class="pa-6 hero-panel">
            <MudText Typo="Typo.h2">Guia de Estruturas de Dados e Algoritmos</MudText>
            <MudText Typo="Typo.h6" Class="mt-2">
                Aprenda como as estruturas são construídas, quais operações elas oferecem
                e como os principais algoritmos percorrem e transformam seus dados.
            </MudText>
            <MudStack Row="true" Class="mt-4" Wrap="Wrap.Wrap" Spacing="2">
                <MudButton Href="/structures" Variant="Variant.Filled" Color="Color.Primary">Explorar estruturas</MudButton>
                <MudButton Href="/algorythms" Variant="Variant.Outlined" Color="Color.Primary">Explorar algoritmos</MudButton>
                <MudButton Href="/run" Variant="Variant.Outlined" Color="Color.Secondary">Laboratório</MudButton>
            </MudStack>
        </MudPaper>

        <section>
            <MudText Typo="Typo.h4">1. Fundamentos</MudText>
            <MudText Class="mt-1">
                Estruturas lineares organizam os elementos em uma sequência ou extremidades bem definidas.
                Estruturas não lineares representam hierarquias e relações entre múltiplos caminhos.
            </MudText>
            <MudGrid Class="mt-2">
                <MudItem xs="12" md="6">
                    <MudCard Class="topic-card">
                        <MudCardContent>
                            <MudText Typo="Typo.h5">Estruturas lineares</MudText>
                            <MudText Class="mt-1">Arrays, listas, filas, pilhas e deques.</MudText>
                            <MudText Typo="Typo.caption">@StructureCatalog.Linear.Count estruturas</MudText>
                        </MudCardContent>
                        <MudCardActions><MudButton Href="/structures">Ver estruturas lineares</MudButton></MudCardActions>
                    </MudCard>
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudCard Class="topic-card">
                        <MudCardContent>
                            <MudText Typo="Typo.h5">Estruturas não lineares</MudText>
                            <MudText Class="mt-1">Árvores, heaps, filas de prioridade e grafos.</MudText>
                            <MudText Typo="Typo.caption">@StructureCatalog.NonLinear.Count estruturas</MudText>
                        </MudCardContent>
                        <MudCardActions><MudButton Href="/structures">Ver estruturas não lineares</MudButton></MudCardActions>
                    </MudCard>
                </MudItem>
            </MudGrid>
        </section>

        <section>
            <MudText Typo="Typo.h4">2. Estruturas de dados</MudText>
            @foreach (var group in new[] { ("Lineares", StructureCatalog.Linear), ("Não lineares", StructureCatalog.NonLinear) })
            {
                <MudText Typo="Typo.h5" Class="mt-4">@group.Item1</MudText>
                <MudGrid Class="mt-1">
                    @foreach (var structure in group.Item2)
                    {
                        <MudItem xs="12" sm="6" lg="4" @key="structure.Key">
                            <MudCard Class="structure-card">
                                <MudCardContent>
                                    <MudText Typo="Typo.h6">@structure.Name</MudText>
                                    <MudText Typo="Typo.body2" Class="mt-1">@structure.Description</MudText>
                                </MudCardContent>
                                <MudCardActions>
                                    <MudButton Href="@($"/structures/{structure.Key}")">Guia</MudButton>
                                    <MudButton Href="@($"/run/{structure.Key}")" Color="Color.Secondary">Executar</MudButton>
                                </MudCardActions>
                            </MudCard>
                        </MudItem>
                    }
                </MudGrid>
            }
        </section>

        <section>
            <MudText Typo="Typo.h4">3. Algoritmos</MudText>
            <MudGrid Class="mt-2">
                <MudItem xs="12" md="6">
                    <MudCard Class="topic-card">
                        <MudCardContent>
                            <MudText Typo="Typo.h5">Ordenação</MudText>
                            <MudText Class="mt-1">Estratégias que reorganizam sequências.</MudText>
                            <MudText Typo="Typo.caption">@AlgorithmCatalog.Sorts.Count algoritmos</MudText>
                        </MudCardContent>
                        <MudCardActions><MudButton Href="/algorythms">Ver ordenação</MudButton></MudCardActions>
                    </MudCard>
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudCard Class="topic-card">
                        <MudCardContent>
                            <MudText Typo="Typo.h5">Busca</MudText>
                            <MudText Class="mt-1">Estratégias para localizar valores.</MudText>
                            <MudText Typo="Typo.caption">@AlgorithmCatalog.Searches.Count algoritmos</MudText>
                        </MudCardContent>
                        <MudCardActions><MudButton Href="/algorythms">Ver busca</MudButton></MudCardActions>
                    </MudCard>
                </MudItem>
            </MudGrid>
        </section>

        <section>
            <MudText Typo="Typo.h4">4. Laboratório visual</MudText>
            <MudPaper Class="pa-5 mt-2" Elevation="1">
                <MudText>
                    Execute um algoritmo e acompanhe as representações das estruturas simultaneamente.
                    Cada algoritmo possui também uma explicação passo a passo com seu fluxo lógico.
                </MudText>
                <MudButton Href="/run" Class="mt-3" Variant="Variant.Filled" Color="Color.Primary">
                    Abrir laboratório
                </MudButton>
            </MudPaper>
        </section>
    </MudStack>
</MudContainer>
