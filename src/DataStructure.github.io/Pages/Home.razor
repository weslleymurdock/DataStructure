@page "/"

@using DataStructure.github.io.Services

<PageTitle>Estruturas de dados e algoritmos</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="py-6">
    <MudStack Spacing="4">
        <MudPaper Elevation="0" Class="pa-6 hero-panel">
            <MudText Typo="Typo.h2">Estruturas de dados e algoritmos</MudText>
            <MudText Typo="Typo.h6" Class="mt-2">
                Um guia visual para entender implementação, complexidade e execução dos algoritmos em .NET 10.
            </MudText>
            <MudStack Row="true" Class="mt-4" Wrap="Wrap.Wrap">
                <MudButton Href="/structures" Variant="Variant.Filled" Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.MenuBook">
                    Guia das estruturas
                </MudButton>
                <MudButton Href="/run" Variant="Variant.Outlined" Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.PlayArrow">
                    Laboratório de execução
                </MudButton>
            </MudStack>
        </MudPaper>

        <MudText Typo="Typo.h4">Mapa do projeto</MudText>
        <MudText>
            Selecione uma estrutura para estudar seu código e os métodos, ou abra a execução para assistir
            aos algoritmos avançando em paralelo.
        </MudText>

        <MudGrid>
            @foreach (var structure in StructureCatalog.All)
            {
                <MudItem xs="12" sm="6" lg="4" @key="structure.Key">
                    <MudCard Class="structure-card">
                        <MudCardHeader>
                            <CardHeaderContent>
                                <MudText Typo="Typo.h5">@structure.Name</MudText>
                                <MudText Typo="Typo.body2">@structure.Description</MudText>
                            </CardHeaderContent>
                        </MudCardHeader>

                        <MudCardContent>
                            <MudChip Color="Color.Info" Size="Size.Small">@structure.Key</MudChip>
                        </MudCardContent>

                        <MudCardActions>
                            <MudButton Href="@($"/structures/{structure.Key}")"
                                       Variant="Variant.Text"
                                       Color="Color.Primary">
                                Implementação
                            </MudButton>
                            <MudButton Href="@($"/run/{structure.Key}")"
                                       Variant="Variant.Text"
                                       Color="Color.Secondary">
                                Run
                            </MudButton>
                        </MudCardActions>
                    </MudCard>
                </MudItem>
            }
        </MudGrid>
    </MudStack>
</MudContainer>
