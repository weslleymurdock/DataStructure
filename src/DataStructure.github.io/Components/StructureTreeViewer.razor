@using DataStructure.github.io.Services

<div class="structure-tree-viewer">
    <MudText Typo="Typo.h6" Class="mb-2">@Title</MudText>

    @if (!string.IsNullOrWhiteSpace(Description))
    {
        <MudText Typo="Typo.body2" Class="mb-3">@Description</MudText>
    }

    <AlgorithmTreeViewer T="string" Root="@Root" />
</div>

@code {
    [Parameter, EditorRequired]
    public AlgorithmTreeDataNode<string>? Root { get; set; }

    [Parameter]
    public string Title { get; set; } = "Representação estrutural";

    [Parameter]
    public string Description { get; set; } = string.Empty;
}
