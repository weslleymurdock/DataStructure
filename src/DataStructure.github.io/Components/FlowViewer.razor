@using DataStructure.github.io.Services
@using Microsoft.AspNetCore.Components
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject NavigationManager Navigation

<div class="flow-viewer">
    <div class="flow-viewer-toolbar">
        <MudText Typo="Typo.caption">Grafo interativo</MudText>
        <div class="flow-viewer-actions">
            <MudButton Variant="Variant.Outlined"
                       Size="Size.Small"
                       OnClick="ResetLayout"
                       StartIcon="@Icons.Material.Filled.AccountTree">
                Reorganizar
            </MudButton>
            <MudButton Variant="Variant.Text"
                       Size="Size.Small"
                       OnClick="FitGraph"
                       StartIcon="@Icons.Material.Filled.FitScreen">
                Ajustar
            </MudButton>
        </div>
    </div>

    <div class="flow-viewer-canvas" @ref="_canvas"></div>

    <section class="flow-viewer-explanation" aria-label="Explicação dos passos do diagrama">
        <MudStack Spacing="1">
            <MudText Typo="Typo.h6">Explicação reproduzível</MudText>
            <MudText Typo="Typo.body2" Class="mb-2">
                Cada linha descreve a operação representada pelo fluxo, o estado que deve ser mantido,
                um pseudocódigo independente de linguagem e o próximo ponto do fluxo.
            </MudText>

            <div class="flow-viewer-table-scroll">
                <MudTable Items="@Steps" Hover="true" Striped="true" Dense="false" Elevation="0" Class="flow-viewer-step-table">
                    <HeaderContent>
                        <MudTh>Step</MudTh>
                        <MudTh>Elemento</MudTh>
                        <MudTh>Explicação</MudTh>
                        <MudTh>Pseudocódigo</MudTh>
                        <MudTh>Direcionamento</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Step">
                            <span class="flow-viewer-step-number">@context.Number</span>
                        </MudTd>
                        <MudTd DataLabel="Elemento">
                            <MudText Typo="Typo.subtitle2">@context.Element</MudText>
                        </MudTd>
                        <MudTd DataLabel="Explicação">@context.Explanation</MudTd>
                        <MudTd DataLabel="Pseudocódigo">
                            <code class="flow-viewer-pseudocode">@context.Pseudocode</code>
                        </MudTd>
                        <MudTd DataLabel="Direcionamento">@context.Direction</MudTd>
                    </RowTemplate>
                </MudTable>
            </div>
        </MudStack>
    </section>

    <div class="flow-viewer-source" aria-hidden="true">
        @ChildContent
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public RenderFragment? ChildContent { get; set; }

    [Parameter]
    public IReadOnlyList<FlowStepGuide> Steps { get; set; } = [];

    private ElementReference _canvas;
    private IJSObjectReference? _module;
    private bool _initialized;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        _module = await JS.InvokeAsync<IJSObjectReference>(
            "import",
            new Uri(string.Concat(Navigation.BaseUri, "js/flow-viewer.js")));

        await _module.InvokeVoidAsync("initialize", _canvas);
        _initialized = true;
    }

    private async Task ResetLayout()
    {
        if (_initialized && _module is not null)
            await _module.InvokeVoidAsync("resetLayout", _canvas);
    }

    private async Task FitGraph()
    {
        if (_initialized && _module is not null)
            await _module.InvokeVoidAsync("fit", _canvas);
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is null)
            return;

        try
        {
            await _module.InvokeVoidAsync("dispose", _canvas);
            await _module.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
        }
    }
}
